---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import BrandStrip from '../components/BrandStrip.astro';
import Work from '../components/Work.astro';
import Testimonials from '../components/Testimonials.astro';
import Services from '../components/Services.astro';
import Bilingual from '../components/Bilingual.astro';
import AuditForm from '../components/AuditForm.astro';
import Process from '../components/Process.astro';
import Packages from '../components/Packages.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Blog from '../components/Blog.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';

const lang = 'es' as const;
---

<Layout lang={lang} routeKey="home">
  <Nav lang={lang} routeKey="home" />
  <main id="main">
    <Hero lang={lang} />
    <BrandStrip lang={lang} />
    <Work lang={lang} />
    <Testimonials lang={lang} />
    <Services lang={lang} />
    <Bilingual lang={lang} />
    <AuditForm lang={lang} />
    <Process lang={lang} />
    <Packages lang={lang} />
    <About lang={lang} />
    <Faq lang={lang} />
    <Blog lang={lang} />
    <FinalCta lang={lang} />
  </main>
  <Footer lang={lang} />
  <WhatsAppFab lang={lang} />
</Layout>
