---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id={t.ids.process} class="section">
  <div class="section-inner">
    <h2 class="section-title process-title">{t.process.title}</h2>

    <ol class="steps" data-reveal-group>
      {
        t.process.steps.map((step, i) => (
          <li class="step">
            <span class="step-label label">
              {t.process.stepLabel} {i + 1}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-title { margin-bottom: clamp(32px, 5vw, 52px); }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(24px, 3vw, 36px);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    border-top: 2px solid var(--fs-ink);
  }

  .step-label {
    font-size: 11px;
    color: var(--fs-accent-ink);
    letter-spacing: 0.12em;
  }

  .step-title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
  }

  .step-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fs-ink-65);
  }
</style>
