---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="brands" aria-label={t.brands.title}>
  <div class="brands-inner">
    <p class="brands-title label">{t.brands.title}</p>
    <ul class="brands-list">
      {t.brands.names.map((name) => <li class="brand-item">{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .brands {
    padding: clamp(28px, 4vw, 40px) clamp(20px, 5vw, 56px);
    border-top: 1px solid var(--fs-line);
    border-bottom: 1px solid var(--fs-line);
    background: var(--fs-surface);
  }
  .brands-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px clamp(24px, 4vw, 48px);
  }

  .brands-title {
    margin: 0;
    font-size: 11px;
    color: var(--fs-ink-50);
    letter-spacing: 0.14em;
  }

  .brands-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px clamp(22px, 3.5vw, 44px);
  }

  /* Wordmarks, not logos — set in expanded Archivo so the strip still reads
     as a brand row. TODO(ivan): swap for real logo files when available. */
  .brand-item {
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 600;
    font-size: clamp(15px, 1.7vw, 19px);
    letter-spacing: -0.005em;
    color: var(--fs-ink-80);
    white-space: nowrap;
  }
</style>
