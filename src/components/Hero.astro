---
import { useTranslations, sectionHref, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { heatmap } = t.hero;
---

<header id={t.ids.top} class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero-title">{t.hero.title}</h1>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <a href={sectionHref(lang, 'audit')} class="btn">{t.hero.ctaPrimary}</a>
        <a href={sectionHref(lang, 'work')} class="link-underline">{t.hero.ctaSecondary} ↓</a>
      </div>
    </div>

    <figure class="heat" role="img" aria-label={heatmap.alt}>
      <figcaption class="heat-caption label">{heatmap.caption}</figcaption>
      <ul class="heat-rows">
        {
          heatmap.rows.map((row) => (
            <li class="heat-row">
              <span class="heat-label label">{row.label}</span>
              <span class="heat-track">
                <span class={`heat-fill heat-fill--${row.heat}`} />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="heat-legend">
        <span class="label">{heatmap.legendLow}</span>
        <span class="heat-scale" aria-hidden="true"></span>
        <span class="label">{heatmap.legendHigh}</span>
      </div>
    </figure>
  </div>
</header>

<style>
  .hero {
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 56px) clamp(56px, 8vw, 104px);
  }

  .hero-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; }

  .eyebrow { margin-bottom: 24px; }

  .hero-title {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero-lead {
    margin: 0 0 36px;
    max-width: 56ch;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.55;
    color: var(--fs-ink-65);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 24px;
  }

  /* ---- heat map ---- */
  .heat {
    margin: 0;
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid var(--fs-line);
    border-radius: var(--radius-lg);
    background: var(--fs-surface);
  }

  .heat-caption {
    font-size: 11.5px;
    color: var(--fs-ink-50);
    margin-bottom: 20px;
    letter-spacing: 0.12em;
  }

  .heat-rows {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .heat-row {
    display: grid;
    grid-template-columns: minmax(80px, 34%) 1fr;
    align-items: center;
    gap: 14px;
  }

  .heat-label {
    font-size: 11px;
    color: var(--fs-ink-65);
    letter-spacing: 0.08em;
  }

  .heat-track {
    height: 22px;
    border-radius: 5px;
    background: rgba(14, 26, 58, 0.07);
    overflow: hidden;
  }

  .heat-fill {
    display: block;
    height: 100%;
    border-radius: 5px;
  }
  /* Thermal scale — heat map only. */
  .heat-fill--5 { width: 100%; background: var(--fs-heat-5); }
  .heat-fill--4 { width: 82%;  background: var(--fs-heat-4); }
  .heat-fill--3 { width: 64%;  background: var(--fs-heat-3); }
  .heat-fill--2 { width: 46%;  background: var(--fs-heat-2); }
  .heat-fill--1 { width: 28%;  background: var(--fs-heat-1); }

  .heat-legend {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    color: var(--fs-ink-50);
  }
  .heat-scale {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: var(--fs-heat-scale);
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
  }
</style>
