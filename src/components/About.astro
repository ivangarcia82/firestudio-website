---
import { Image } from 'astro:assets';
import { useTranslations, waHref, type Lang } from '../i18n';
import studioPhoto from '../assets/projects/studio.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const wa = waHref(lang, 'general');
---

<section id={t.ids.about} class="section">
  <div class="section-inner about-inner" data-reveal>
    <div class="about-media">
      <Image
        src={studioPhoto}
        alt={t.about.photoAlt}
        class="media-cover about-img"
        widths={[480, 800, 1000]}
        sizes="(max-width: 900px) 100vw, 50vw"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-body">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="about-title">{t.about.title}</h2>
      <p class="about-text">{t.about.text}</p>

      <ul class="promises">
        {t.about.promises.map((promise) => <li class="promise">{promise}</li>)}
      </ul>

      <a
        href={wa}
        target="_blank"
        rel="noopener"
        class="link-underline about-link"
        data-track="contact"
        data-track-placement="about"
      >
        {t.about.cta} →
      </a>
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .about-media {
    position: relative;
    height: clamp(300px, 38vw, 440px);
  }
  .about-img { border-radius: var(--radius-lg); }

  .about-body { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .about-title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: clamp(27px, 3.6vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .about-text {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--fs-ink-65);
  }

  .promises {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .promise {
    padding: 16px 18px;
    border-left: 3px solid var(--fs-accent);
    background: var(--fs-surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.35;
    letter-spacing: -0.005em;
  }
</style>
