---
import { Image } from 'astro:assets';
import { waHref } from '../data/site';
import studioPhoto from '../assets/projects/studio.jpg';
---

<section id="nosotros" class="about">
  <div class="about-inner" data-reveal>
    <div class="about-media">
      <Image
        src={studioPhoto}
        alt="Equipo de Fire Studio trabajando en laptops en el estudio"
        class="media-cover about-img"
        widths={[480, 800, 1000]}
        sizes="(max-width: 760px) 100vw, 50vw"
      />
    </div>
    <div class="about-body">
      <p class="eyebrow">Sobre nosotros</p>
      <h2 class="about-title">Cuando nos escribes, te contesta quien va a hacer tu proyecto.</h2>
      <p class="about-text">
        Fire Studio es un estudio de Mérida dirigido por Ivan, desarrollador con experiencia
        construyendo tiendas Shopify para marcas de moda y proyectos web a la medida. Sin
        intermediarios ni vendedores: la persona que entiende tu negocio es la misma que diseña y
        programa tu sitio.
      </p>
      <a href={waHref} target="_blank" rel="noopener" class="link-underline link-underline--amber about-link">
        Escríbenos, contestamos nosotros →
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(56px, 8vw, 110px) clamp(20px, 5vw, 56px);
    border-top: 1px solid rgba(242, 233, 225, 0.08);
  }
  .about-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .about-media {
    position: relative;
    height: clamp(320px, 40vw, 460px);
  }
  .about-img { border-radius: 20px; }

  .about-body { display: flex; flex-direction: column; gap: 20px; }
  .about-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 4.5vw, 48px);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .about-text {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(242, 233, 225, 0.75);
  }
  .about-link { align-self: flex-start; }
</style>
