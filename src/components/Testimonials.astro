---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section--surface">
  <div class="section-inner">
    <div class="head">
      <h2 class="section-title">{t.testimonials.title}</h2>
      {t.testimonials.note && <p class="note label">{t.testimonials.note}</p>}
    </div>

    <div class="grid" data-reveal-group>
      {
        t.testimonials.items.map((item) => (
          <figure class="testimonial">
            <blockquote>{item.quote}</blockquote>
            <figcaption>
              <span class="name">{item.name}</span>
              <span class="context label">{item.context}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: clamp(32px, 5vw, 52px);
  }
  .note {
    margin: 0;
    font-size: 11px;
    color: var(--fs-ink-50);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }

  .testimonial {
    margin: 0;
    border: 1px solid var(--fs-line);
    border-radius: var(--radius-lg);
    padding: 28px;
    background: var(--fs-bg);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .testimonial blockquote {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--fs-ink-80);
  }
  .testimonial blockquote::before { content: '“'; }
  .testimonial blockquote::after { content: '”'; }
  .testimonial figcaption { display: flex; flex-direction: column; gap: 3px; }
  .name { font-weight: 600; }
  .context {
    font-size: 11px;
    color: var(--fs-ink-50);
  }
</style>
