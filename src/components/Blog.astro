---
import { Image } from 'astro:assets';
import { getSortedPosts, formatDate } from '../lib/blog';
import { useTranslations, blogPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getSortedPosts()).slice(0, 3);
---

<section id="blog" class="section section--surface">
  <div class="section-inner">
    <div class="blog-head">
      <h2 class="section-title">{t.blog.title}</h2>
      {/* The blog is Spanish-only — in English the link says so. */}
      <a href={blogPath} class="link-underline">
        {lang === 'es' ? t.blog.seeAll : t.footer.blog} →
      </a>
    </div>

    <div class="blog-grid" data-reveal-group>
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="post-card" aria-label={post.data.title}>
            <div class="post-media">
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt}
                class="media-cover"
                widths={[320, 560, 800]}
                sizes="(max-width: 760px) 100vw, 33vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="post-body">
              <span class="chip">{post.data.category}</span>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              <p class="post-meta label">{formatDate(post.data.date)} · {post.data.readingTime}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .blog-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--fs-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--fs-bg);
    color: var(--fs-ink);
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .post-media { position: relative; height: 190px; }
  .post-media .media-cover { transition: transform 0.35s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .post-card:hover { border-color: var(--fs-accent); transform: translateY(-3px); color: var(--fs-ink); }
    .post-card:hover .post-media .media-cover { transform: scale(1.04); }
  }

  .post-body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .post-title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .post-excerpt {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--fs-ink-65);
  }
  .post-meta {
    margin: auto 0 0;
    padding-top: 6px;
    font-size: 11px;
    color: var(--fs-ink-50);
  }
</style>
