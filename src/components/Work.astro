---
import { Image } from 'astro:assets';
import { useTranslations, waHref, workPath, type Lang } from '../i18n';
import { localizedFeatured, localizedGrid } from '../i18n/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = localizedFeatured(lang);
const gridProjects = localizedGrid(lang);
const wa = waHref(lang, 'general');
---

<section id={t.ids.work} class="section work">
  <div class="section-inner">
    <div class="work-head">
      <h2 class="section-title">{t.work.title}</h2>
      <p class="work-note">{t.work.note}</p>
    </div>

    <article class="featured" data-reveal>
      <a href={workPath(featured.slug)} class="featured-media" aria-label={`${t.work.viewCaseShort}: ${featured.name}`}>
        <Image
          src={featured.image}
          alt={featured.alt}
          class="media-cover"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 50vw"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="featured-body">
        <div class="featured-tags">
          <span class="chip chip--accent">{t.work.featuredChip}</span>
          <span class="chip">{featured.category}</span>
        </div>
        <h3 class="featured-title">
          <a href={workPath(featured.slug)}>{featured.name} — {featured.tagline.toLowerCase()}</a>
        </h3>
        <div class="featured-detail">
          <p><strong class="detail-label">{t.work.labelChallenge}</strong>{featured.reto}</p>
          <p><strong class="detail-label">{t.work.labelSolution}</strong>{featured.solucion}</p>
          <p><strong class="detail-label">{t.work.labelResult}</strong>{featured.resultado}</p>
        </div>
        <a href={workPath(featured.slug)} class="link-underline featured-more">{t.work.viewCase} →</a>
      </div>
    </article>

    <div class="grid" data-reveal-group>
      {
        gridProjects.map((p) => (
          <a href={workPath(p.slug)} class="card" aria-label={`${t.work.viewCaseShort}: ${p.name}`}>
            <div class="card-media">
              <Image
                src={p.image}
                alt={p.alt}
                class="media-cover"
                widths={[320, 580, 900]}
                sizes="(max-width: 760px) 100vw, 33vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-body">
              <span class="chip">{p.category}</span>
              <h3 class="card-title">{p.name}</h3>
              <p class="card-summary">{p.summary}</p>
              <span class="card-more label">{t.work.viewCaseShort} →</span>
            </div>
          </a>
        ))
      }

      <article class="card card--cta">
        <p class="label cta-eyebrow">{t.work.nextEyebrow}</p>
        <h3 class="cta-title">{t.work.nextTitle}</h3>
        <a href={wa} target="_blank" rel="noopener" class="link-underline" data-track="contact" data-track-placement="work">
          {t.work.nextCta} →
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: clamp(32px, 5vw, 52px);
  }
  .work-note {
    margin: 0;
    max-width: 46ch;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--fs-ink-65);
  }

  /* Featured */
  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    border: 1px solid var(--fs-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--fs-surface);
    margin-bottom: 28px;
  }
  .featured-media { position: relative; min-height: 340px; display: block; }
  .featured-body {
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .featured-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .featured-title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .featured-title a { color: var(--fs-ink); transition: color 0.2s ease; }
  .featured-title a:hover { color: var(--fs-accent-ink); }
  .featured-more { align-self: flex-start; }
  .featured-detail {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--fs-ink-80);
  }
  .featured-detail p { margin: 0; }
  .detail-label {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-label);
    font-stretch: var(--wdth-condensed);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fs-accent-ink);
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 24px;
  }

  .card {
    border: 1px solid var(--fs-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--fs-bg);
    display: flex;
    flex-direction: column;
    color: var(--fs-ink);
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  /* Touch devices fire :hover on tap and leave it stuck — gate lift behind a real pointer. */
  @media (hover: hover) and (pointer: fine) {
    .card:hover { border-color: var(--fs-accent); transform: translateY(-3px); color: var(--fs-ink); }
  }

  .card-media { position: relative; height: 240px; }

  .card-body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card-title {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .card-summary {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--fs-ink-65);
  }
  .card-more {
    margin-top: 4px;
    font-size: 11.5px;
    color: var(--fs-accent-ink);
  }

  /* CTA card */
  .card--cta {
    border-style: dashed;
    border-color: var(--fs-ink-35);
    background: transparent;
    align-items: flex-start;
    justify-content: center;
    gap: 14px;
    padding: 32px;
    min-height: 240px;
  }
  .card--cta:hover { transform: none; }
  .cta-eyebrow {
    margin: 0;
    font-size: 11px;
    color: var(--fs-ink-50);
  }
  .cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
</style>
