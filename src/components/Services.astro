---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id={t.ids.services} class="section services">
  <div class="section-inner">
    <h2 class="section-title services-title">{t.services.title}</h2>

    <div class="services-list" data-reveal-group>
      {
        t.services.items.map((service, i) => (
          <article class={`service${service.highlight ? ' service--highlight' : ''}`}>
            <span class="service-num label">{String(i + 1).padStart(2, '0')}</span>
            <div class="service-copy">
              <h3 class="service-name">{service.name}</h3>
              <p class="service-body">{service.body}</p>
              <p class="service-audience label">{service.audience}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="services-footnote">{t.services.footnote}</p>
  </div>
</section>

<style>
  .services-title { margin-bottom: clamp(32px, 5vw, 52px); }

  .services-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1px;
    background: var(--fs-line);
    border: 1px solid var(--fs-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .service {
    display: flex;
    gap: 16px;
    padding: clamp(24px, 3vw, 32px);
    background: var(--fs-bg);
  }

  .service--highlight { background: var(--fs-accent-soft); }

  .service-num {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--fs-accent-ink);
    letter-spacing: 0.08em;
    padding-top: 3px;
  }

  .service-copy { display: flex; flex-direction: column; gap: 8px; }

  .service-name {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 700;
    font-size: clamp(19px, 2vw, 22px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .service-body {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--fs-ink-65);
  }

  .service-audience {
    margin: 2px 0 0;
    font-size: 11px;
    color: var(--fs-ink-50);
    letter-spacing: 0.08em;
  }

  .services-footnote {
    margin: clamp(28px, 4vw, 40px) 0 0;
    font-family: var(--font-display);
    font-stretch: var(--wdth-expanded);
    font-weight: 600;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--fs-ink);
    text-wrap: balance;
  }
</style>
