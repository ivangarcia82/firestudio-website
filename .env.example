# Copy to `.env` for local development and set the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Server-side only -------------------------------------------------------
# HubSpot private app token used by /api/audit to create or update contacts.
# Needs the crm.objects.contacts.read and crm.objects.contacts.write scopes.
# While this is unset, the audit form falls back to WhatsApp.
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Exposed to the browser (PUBLIC_ prefix) --------------------------------
# Meta Pixel id. Leave empty to not load the pixel at all.
PUBLIC_META_PIXEL_ID=

# GA4 measurement id (G-XXXXXXXXXX). Leave empty to not load GA4 at all.
PUBLIC_GA4_ID=
